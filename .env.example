# ---------------------------------------------------------------------------
# نمونهٔ تنظیمات محیطی - هیچ مقدار واقعی در این فایل نگذارید.
# برای توسعهٔ محلی: cp .env.example .env && chmod 600 .env
# برای Cloudflare:  npx wrangler secret put <NAME>
# ---------------------------------------------------------------------------

# --- تلگرام -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=          # فقط عدد؛ چند نفر را با کاما جدا کنید: 1001,2002

# --- امنیت -------------------------------------------------------------------
APPROVAL_SECRET=            # رشتهٔ تصادفی بلند (امضای دکمه‌های تأیید)
ACTIONS_CALLBACK_TOKEN=     # توکن مشترک برای کالبک GitHub Actions و /admin

# --- گیت‌هاب (یکی از دو روش) -------------------------------------------------
# روش ۱: GitHub App (توصیه)
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=     # محتوای کامل فایل .pem
# روش ۲: Personal Access Token (فقط یک مخزن)
GITHUB_TOKEN=

# --- ارائه‌دهنده‌های هوش مصنوعی (همه اختیاری؛ رایگان‌ها اول) ------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# پولی - فقط اگر خودتان فعال کنید
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- تنظیمات غیرمحرمانه ------------------------------------------------------
WEBHOOK_PATH=/telegram/webhook
BOT_CALLBACK_URL=           # مثلاً https://<worker>.workers.dev/actions/callback
DEFAULT_BRANCH=main
AI_DAILY_TOKEN_LIMIT=500000
AI_MONTHLY_TOKEN_LIMIT=10000000
ACTIONS_MONTHLY_MINUTE_LIMIT=2000
MAX_UPLOAD_BYTES=200000
MAX_DIFF_BYTES=90000
COMMAND_ALLOWLIST=npm test,npm run test,pytest,pytest -q,npm run lint,npm run build,cargo test,go test ./...,mvn -q test
